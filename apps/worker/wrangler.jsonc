{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driver-labor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  // Wrangler 사용 통계를 Cloudflare로 보내지 않는다.
  "send_metrics": false,
  "observability": {
    // 요청 본문·검색어·좌표를 남기지 않는다 (CLAUDE.md 절대 규칙 7).
    // 오류 코드만 필요하므로 기본 로그 수집을 끈다.
    "enabled": false,
  },
  // 8787은 다른 로컬 서비스가 쓰고 있어 8788로 둔다.
  "dev": {
    "port": 8788,
  },
  "assets": {
    "directory": "./dist-assets",
    "binding": "ASSETS",
    // 정적 자산이 Worker 코드보다 먼저 응답한다.
    // /api/* 만 예외로 Worker가 먼저 받는다 (architecture.md "Worker 요청 한도 방어").
    "run_worker_first": ["/api/*"],
  },
  // 유가 평균, 비상 스위치(auto_route·auto_places·provider), 당일 차단 목록.
  // id는 M6에서 `wrangler kv namespace create`로 만든 뒤 채운다. 로컬 dev는 이 값 그대로 동작한다.
  "kv_namespaces": [{ "binding": "CTRL", "id": "00000000000000000000000000000000" }],
  // 일일 예산 카운터와 경로 응답 캐시. 무료 플랜은 SQLite 기반 DO만 쓸 수 있다.
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "BudgetCounter" },
      { "name": "ROUTE_CACHE", "class_name": "RouteCache" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetCounter", "RouteCache"] }],
  // 매시 정각: 사용률 알림, KST 0·6·12·18시에는 유가 갱신도 (무료 계정당 Cron 5개 중 1개).
  "triggers": { "crons": ["0 * * * *"] },
  // 분당 제한 (Rate Limiting 바인딩). 무료 플랜에서 못 쓰면 이 블록을 지운다.
  // 바인딩이 없으면 세션 분당 제한은 BudgetCounter가 대신 센다.
  "ratelimits": [
    { "name": "RL_SESSION_IP", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_ROUTE_SESSION", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ROUTE_IP", "namespace_id": "1003", "simple": { "limit": 15, "period": 60 } },
    {
      "name": "RL_PLACES_SESSION",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
    { "name": "RL_PLACES_IP", "namespace_id": "1005", "simple": { "limit": 90, "period": 60 } },
  ],
}
